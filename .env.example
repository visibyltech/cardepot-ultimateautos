# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Cloudinary configuration for vehicle & receipt uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Optional WhatsApp Business Cloud API credentials for automated dealership alerts
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_RECIPIENT="2348165695833"

# Optional Paystack secret key for server-side Nigerian Naira payment verification
PAYSTACK_SECRET_KEY=""
